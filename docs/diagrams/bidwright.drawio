"1" parent="1"><mxGeometry as="geometry" x="1190" y="42" width="350" height="38" /></mxCell><mxCell id="source" value="&lt;b&gt;01 Retrieve evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Verified RFP requirements&lt;br&gt;Retrieved supplier KB records&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="180" width="300" height="130" /></mxCell><mxCell id="author" value="&lt;b&gt;02 Propose a claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Decide agent names evidence&lt;br&gt;Code restricts IDs to records seen&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="180" width="300" height="130" /></mxCell><mxCell id="assessor" value="&lt;b&gt;03 Blind assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Claim + cited records + need&lt;br&gt;No author reasoning or turns&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="180" width="300" height="130" /></mxCell><mxCell id="coverage" value="&lt;b&gt;04 Capability status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Code applies the rule&lt;br&gt;GAP / PARTNER&lt;br&gt;COVERED / PARTIAL&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="180" width="280" height="130" /></mxCell><mxCell id="no-evidence" value="&lt;font style=&quot;font-size:16px&quot;&gt;No cited evidence → UNVERIFIED in code, with no assessor call. A verified quote proves&lt;br&gt;grounding, not complete requirement coverage.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="355" width="710" height="82" /></mxCell><mxCell id="route" value="&lt;font style=&quot;font-size:16px&quot;&gt;The assessment route is fixed for a run and recorded. Another model family is hygiene; joint error&lt;br&gt;and owner labels test its reliability.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="355" width="730" height="82" /></mxCell><mxCell id="risks" value="&lt;b&gt;08 Risk register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Triggers, evidence and response&lt;br&gt;Date/SLA arithmetic in code&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="490" width="300" height="130" /></mxCell><mxCell id="tech" value="&lt;b&gt;07 Technology checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Documentation supports verdicts&lt;br&gt;Verdict quotes checked in code&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3