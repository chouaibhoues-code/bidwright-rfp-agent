ueprint" target="techcheck"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="techcheck-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="techcheck" target="risk"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="risk-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="risk" target="gate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="gate-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="draft"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="draft-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="draft" target="render"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="tech-revise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9D6F35;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="techcheck" target="blueprint"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="30" y="720" /><mxPoint x="30" y="490" /></Array></mxGeometry></mxCell><mxCell id="option-change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9D6F35;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="gate" target="blueprint"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="790" y="585" /><mxPoint x="325" y="585" /><mxPoint x="325" y="490" /></Array></mxGeometry></mxCell><mxCell id="human-edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9D6F35;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="gate" target="techcheck"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="790" y="825" /><mxPoint x="180" y="825" /></Array></mxGeometry></mxCell><mxCell id="status" value="&lt;font style=&quot;font-size:12px&quot;&gt;ITERATION 3 TARGET | UNREVIEWED_DRAFT&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="42" width="350" height="38" /></mxCell><mxCell id="ingest" value="&lt;b&gt;01 Guard + ingest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Sanitize files&lt;br&gt;Parse and freeze passages&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="200" width="240" height="120" /></mxCell><mxCell id="extract" value="&lt;b&gt;02 Extract + verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;LLM reads every passage&lt;br&gt;Code checks quotes and values&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="200" width="240" height="120" /></mxCell><mxCell id="coverage" value="&lt;b&gt;03 Cover +&lt;br&gt;consolidate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Coverage repair and lint&lt;br&gt;Group related requirements&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12.5;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="200" width="240" height="120" /></mxCell><mxCell id="brief" value="&lt;b&gt;04 Opportunity brief&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Factors, weights, scope&lt;br&gt;Checked research topics&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="200" width="240" height="120" /></mxCell><mxCell id="research" value="&lt;b&gt;05 Domain research&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Pack / live / off&lt;br&gt;External and unverified&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="200" width="240" height="120" /></mxCell><mxCell id="blueprint" value="&lt;b&gt;10 Blueprint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Sourced manifest + WBS&lt;br&gt;Binding coverage or gaps&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="430" width="240" height="120" /></mxCell><mxCell id="options" value="&lt;b&gt;09 Options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Generate alternatives&lt;br&gt;Code weights and ranks&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="430" width="240" height="120" /></mxCell><mxCell id="map" value="&lt;b&gt;08 Capability map&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Code sets coverage status&lt;br&gt;Evidence and gaps stay visible&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="430" width="240" height="120" /></mxCell><mxCell id="assess" value="&lt;b&gt;07 Blind assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;One call per cited claim&lt;br&gt;No evidence → UNVERIFIED&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="430" width="240" height="120" /></mxCell><mxCell id="decide" value="&lt;b&gt;06 Decide&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Plan, then one agent per need&lt;br&gt;Join decisions and claims&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="430" width="240" height="120" /></mxCell><mxCell id="techcheck" value="&lt;b&gt;11 Techcheck&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Documentation-based verdicts&lt;br&gt;INVALIDATED → one revision&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="660" width="240" height="120" /></mxCell><mxCell id="risk" value="&lt;b&gt;12 Risk agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Manifest, hazards and gaps&lt;br&gt;Search + date/SLA arithmetic&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="660" width="240" height="120" /></mxCell><mxCell id="gate" value="&lt;b&gt;13 Human gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;WAITING_HUMAN&lt;br&gt;Approve, edit or reject&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFF0D5;strokeColor=#D2A052;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="670" y="660" width="240" height="120" /></mxCell><mxCell id="draft" value="&lt;b&gt;14 Draft&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Three short sections&lt;br&gt;From checked solution records&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="660" width="240" height="120" /></mxCell><mxCell id="render" value="&lt;b&gt;15 Validate + render&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Summary and review artifacts&lt;br&gt;UNREVIEWED_DRAFT&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="660" width="240" height="120" /></mxCell><mxCell id="exceptions" value="&lt;font style=&quot;font-size:15px&quot;&gt;Research off: brief → decide. Blueprint failure: fall back to approach → risk; report degradation.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="866" width="710" height="75" /></mxCell><mxCell id="policy" value="&lt;font style=&quot;font-size:15px&quot;&gt;Reject / blocked automatic approval → POLICY_BLOCKED, no draft. Method cards and reflect start&lt;br&gt;disabled.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="866" width="710" height="75" /></mxCell><mxCell id="title" value="Bidwright | the end-to-end workflow" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#173047;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="38" width="1100" height="45" /></mxCell><mxCell id="subtitle" value="Numbered execution path; dashed lines show revision and human-edit feedback" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="93" width="1475" height="28" /></mxCell><mxCell id="footer" value="BIDWRIGHT / Submission diagrams / Accepted Iteration 3 design / Verify against the final build" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="962" width="1480" height="22" /></mxCell><mxCell id="phase-r" value="01 / READ AND VERIFY THE RFP" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="151" width="1460" height="26" /></mxCell><mxCell id="phase-e" value="02 / DEVELOP A SOLUTION FROM EVIDENCE ←" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="380" width="1460" height="26" /></mxCell><mxCell id="phase-h" value="03 / VALIDATE, REVIEW AND DRAFT" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="610" width="1155" height="26" /></mxCell><mxCell id="option-change-label" value="Choose another option" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;f