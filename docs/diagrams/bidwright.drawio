yle="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifacts" target="scorer"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="677.5" y="720" /><mxPoint x="495" y="720" /></Array></mxGeometry></mxCell><mxCell id="score-gold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gold" target="scorer"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="score-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="scorer" target="reports"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="artifacts" target="traces"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="677.5" y="720" /><mxPoint x="1310" y="720" /></Array></mxGeometry></mxCell><mxCell id="status" value="&lt;font style=&quot;font-size:12px&quot;&gt;ITERATION 3 TARGET | UNREVIEWED_DRAFT&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="42" width="350" height="38" /></mxCell><mxCell id="rfp" value="&lt;b&gt;Synthetic RFP package&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;PDF / DOCX / XLSX&lt;br&gt;Addenda and precedence&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="155" width="280" height="112" /></mxCell><mxCell id="kb" value="&lt;b&gt;Supplier knowledge base&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Capabilities, case studies&lt;br&gt;Certifications and roles&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="155" width="280" height="112" /></mxCell><mxCell id="packs" value="&lt;b&gt;Hashed research packs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Domain context + library docs&lt;br&gt;Pack mode avoids live lookup&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="155" width="280" height="112" /></mxCell><mxCell id="config" value="&lt;b&gt;Versioned configuration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Prompts, schemas, models&lt;br&gt;Limits and tool allowlists&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1200" y="155" width="280" height="112" /></mxCell><mxCell id="runtime" value="&lt;b&gt;CLI + LangGraph workflow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Guard and parsing → requirements → research → solution → review → drafting&lt;br&gt;Supervisor: lock, checkpoints, stop/resume, answered-call journal&lt;br&gt;Context manager + budget/recovery + tool gateway enforce controls outside the model&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=18;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="365" width="890" height="140" /></mxCell><mxCell id="ui" value="&lt;b&gt;Run / Review / Ops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Loopback UI + API&lt;br&gt;Read files; controls use CLI&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFF0D5;strokeColor=#D2A052;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="545" width="245" height="112" /></mxCell><mxCell id="artifacts" value="&lt;b&gt;Run artifacts | UNREVIEWED_DRAFT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Solution summary, matrix, manifest, risks and review files&lt;br&gt;Ledger, status/events, tool calls, context manifests and spans&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="375" y="545" width="605" height="112" /></mxCell><mxCell id="docling" value="&lt;b&gt;Docling | local parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Sanitized file bytes; live/record only&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F2F5F8;strokeColor=#9AA9B6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=12;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="365" width="420" height="74" /></mxCell><mxCell id="models" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Generate: Gemini / Ollama&lt;br&gt;Assess (fixed/run): Cerebras / Groq / same family&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=8;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="465" width="420" height="86" /></mxCell><mxCell id="mcp" value="&lt;b&gt;Research MCP servers | live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;NotebookLM: domain topics, never RFP text&lt;br&gt;Context7: technology documentation&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F2F5F8;strokeColor=#9AA9B6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="577" width="420" height="90" /></mxCell><mxCell id="gold" value="&lt;b&gt;Hashed gold + specs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Known answers&lt;br&gt;No producer access&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=11.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="85" y="805" width="230" height="92" /></mxCell><mxCell id="scorer" value="&lt;b&gt;bidwright-eval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Reads finished run artifacts&lt;br&gt;Scores quality and safety&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=11.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="805" width="270" height="92" /></mxCell><mxCell id="reports" value="&lt;b&gt;Scorecards + reports&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Misses, loss funnel&lt;br&gt;Regression and comparisons&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=11.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="675" y="805" width="320" height="92" /></mxCell><mxCell id="traces" value="&lt;b&gt;Ops totals + Phoenix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Ledger reconciliation and OTLP traces&lt;br&gt;Local spans.jsonl when no collector&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=11.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="805" width="420" height="92" /></mxCell><mxCell id="title" value="Bidwright | system architecture" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#173047;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="38" width="1100" height="45" /></mxCell><mxCell id="subtitle" value="Local orchestration, explicit service boundaries, and evaluation kept outside the producer" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="93" width="1475" height="28" /></mxCell><mxCell id="footer" value="BIDWRIGHT / Submission diagrams / Accepted Iteration 3 design / Verify against the final build" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="962" width="1480" height="22" /></mxCell><mxCell id="producer-label" value="LOCAL APPLICATION / PRODUCER" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="82" y="325" width="916" height="26" /></mxCell><mxCell id="services-label" value="SERVICES / PROFILE DEPENDENT" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1102" y="325" width="416" height="26" /></mxCell><mxCell id="evaluation-label" value="SEPARATE EVALUATION HARNESS" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="82" y="765" width="916" height="26" /></mxCell><mxCell id="telemetry-label" value="OBSERVABILITY" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1102" y="765" width="416" height="26" /></mxCell><mxCell id="boundary-note" value="Research is external context, never supplier capability evidence. The producer never reads evaluation gold or corpus specs." style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColo