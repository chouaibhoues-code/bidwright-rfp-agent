y=0;" edge="1" parent="1" source="review" target="approve"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="530" y="817" /><mxPoint x="530" y="736" /><mxPoint x="710" y="736" /></Array></mxGeometry></mxCell><mxCell id="review-edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#A47A35;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="review" target="edit"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="530" y="817" /><mxPoint x="530" y="736" /><mxPoint x="1040" y="736" /></Array></mxGeometry></mxCell><mxCell id="review-reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#A47A35;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="review" target="reject"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="530" y="817" /><mxPoint x="530" y="736" /><mxPoint x="1370" y="736" /></Array></mxGeometry></mxCell><mxCell id="status" value="&lt;font style=&quot;font-size:12px&quot;&gt;ITERATION 3 TARGET | UNREVIEWED_DRAFT&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="42" width="350" height="38" /></mxCell><mxCell id="source" value="&lt;b&gt;01 Retrieve evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Verified RFP requirements&lt;br&gt;Retrieved supplier KB records&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="180" width="300" height="130" /></mxCell><mxCell id="author" value="&lt;b&gt;02 Propose a claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Decide agent names evidence&lt;br&gt;Code restricts IDs to records seen&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="180" width="300" height="130" /></mxCell><mxCell id="assessor" value="&lt;b&gt;03 Blind assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Claim + cited records + need&lt;br&gt;No author reasoning or turns&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="180" width="300" height="130" /></mxCell><mxCell id="coverage" value="&lt;b&gt;04 Capability status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Code applies the rule&lt;br&gt;GAP / PARTNER&lt;br&gt;COVERED / PARTIAL&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="180" width="280" height="130" /></mxCell><mxCell id="no-evidence" value="&lt;font style=&quot;font-size:16px&quot;&gt;No cited evidence → UNVERIFIED in code, with no assessor call. A verified quote proves&lt;br&gt;grounding, not complete requirement coverage.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="355" width="710" height="82" /></mxCell><mxCell id="route" value="&lt;font style=&quot;font-size:16px&quot;&gt;The assessment route is fixed for a run and recorded. Another model family is hygiene; joint error&lt;br&gt;and owner labels test its reliability.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#D3DEE6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="355" width="730" height="82" /></mxCell><mxCell id="risks" value="&lt;b&gt;08 Risk register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Triggers, evidence and response&lt;br&gt;Date/SLA arithmetic in code&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="490" width="300" height="130" /></mxCell><mxCell id="tech" value="&lt;b&gt;07 Technology checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Documentation supports verdicts&lt;br&gt;Verdict quotes checked in code&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="490" width="300" height="130" /></mxCell><mxCell id="manifest" value="&lt;b&gt;06 Solution manifest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Sourced facts and work packages&lt;br&gt;Binding requirements mapped or&lt;br&gt;explicit gaps&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="490" width="300" height="130" /></mxCell><mxCell id="options" value="&lt;b&gt;05 Ranked options&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Published factors and weights&lt;br&gt;Code totals and tie-breaks&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1260" y="490" width="280" height="130" /></mxCell><mxCell id="review" value="&lt;b&gt;09 WAITING_HUMAN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Review options, gaps, manifest&lt;br&gt;Technology verdicts and risks&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFF0D5;strokeColor=#D2A052;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="762" width="400" height="110" /></mxCell><mxCell id="approve" value="&lt;b&gt;Approve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Continue to drafting&lt;br&gt;Draft label remains&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="762" width="280" height="110" /></mxCell><mxCell id="edit" value="&lt;b&gt;Edit / change option&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Rebuild or recheck&lt;br&gt;Technology and risk rerun&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFF0D5;strokeColor=#D2A052;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="762" width="280" height="110" /></mxCell><mxCell id="reject" value="&lt;b&gt;Reject / block&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;POLICY_BLOCKED&lt;br&gt;No draft is produced&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FBEDEC;strokeColor=#C78A84;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=15;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1230" y="762" width="280" height="110" /></mxCell><mxCell id="title" value="Bidwright | from a claim to a reviewed draft" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#173047;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="38" width="1100" height="45" /></mxCell><mxCell id="subtitle" value="Independent evidence checks, deterministic coverage, and a human boundary before drafting" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="93" width="1475" height="28" /></mxCell><mxCell id="footer" value="BIDWRIGHT / Submission diagrams / Accepted Iteration 3 design / Verify against the final build" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="962" width="1480" height="22" /></mxCell><mxCell id="review-panel-label" value="HUMAN REVIEW / APPROVAL HASHES BIND THE MANIFEST AND OPTIONS" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="715" width="965" height="26" /></mxCell><mxCell id="draft-boundary" value="Approval permits the workflow to continue. It does not sign off a bid, remove UNREVIEWED_DRAFT, or submit anything." style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=15;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="931" width="1480" height="22" /></mxCell></root></mxGraphModel></diagram></mxfile>