<mxfile host="app.diagrams.net" agent="Bidwright submission diagrams" type="device" compressed="false"><diagram id="03-evidence-and-approval" name="03 Evidence and approval"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="review-panel" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=5;fillColor=#F8FAFC;strokeColor=#D6E0E8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="700" width="1480" height="205" /></mxCell><mxCell id="source-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="source" target="author"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="author-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="author" target="assessor"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="assessor-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="assessor" target="coverage"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="map-options" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entr