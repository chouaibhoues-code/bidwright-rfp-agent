<mxfile host="app.diagrams.net" agent="Bidwright submission diagrams" type="device" compressed="false"><diagram id="04-evaluation-and-observability" name="04 Evaluation and observability"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="eval" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=5;fillColor=#F8FAFC;strokeColor=#D6E0E8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="330" width="720" height="415" /></mxCell><mxCell id="obs" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=5;fillColor=#F8FAFC;strokeColor=#D6E0E8;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="330" width="720" height="415" /></mxCell><mxCell id="gold-eval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gold" target="eval-harness"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="artifacts-eval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="eval-harness"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="303" /><mxPoint x="580" y="303" /></Array></mxGeometry></mxCell><mxCell id="score" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval-harness" target="scorecard"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="580" y="511" /><mxPoint x="420" y="511" /></Array></mxGeometry></mxCell><mxCell id="record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="run" target="records"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="211" /></Array></mxGeometry></mxCell><mxCell id="records-ops" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="records" target="ops"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="511" /><mxPoint x="1000" y="511" /></Array></mxGeometry></mxCell><mxCell id="records-phoenix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="records" target="phoenix"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1180" y="511" /><mxPoint x="1360" y="511" /></Array></mxGeometry></mxCell><mxCell id="compare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6D8193;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scorecard" target="comparisons"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="420" y="770" /><mxPoint x="420" y="770" /></Array></mxGeometry></mxCell><mxCell id="status" value="&lt;font style=&quot;font-size:12px&quot;&gt;ITERATION 3 TARGET | UNREVIEWED_DRAFT&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#E1F3EC;strokeColor=#5C9D89;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=10;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1190" y="42" width="350" height="38" /></mxCell><mxCell id="run" value="&lt;b&gt;Frozen run artifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Run ID, records, ledger and traces&lt;br&gt;Prompt versions and model route&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=17;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="155" width="440" height="112" /></mxCell><mxCell id="gold" value="&lt;b&gt;Gold + hypotheses&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Hashed known answers&lt;br&gt;Fixed before experiments&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=13;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="388" width="250" height="100" /></mxCell><mxCell id="eval-harness" value="&lt;b&gt;bidwright-eval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Match records, score seeds&lt;br&gt;Attribute misses to their stage&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="410" y="388" width="340" height="100" /></mxCell><mxCell id="scorecard" value="&lt;b&gt;Scorecard + loss funnel + regression gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Headline: missed mandatory requirements and submission hazards&lt;br&gt;Grounding, trap actions and unauthorized calls&lt;br&gt;Unsupported capabilities, manifest checks and technology verdicts&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=20;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="535" width="660" height="170" /></mxCell><mxCell id="records" value="&lt;b&gt;Ledger + events + spans&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Tokens by category, retries, status history, model/provider route&lt;br&gt;Active latency, charged cost and paid-rate shadow cost&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9DAFBD;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=13.0;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="388" width="660" height="100" /></mxCell><mxCell id="ops" value="&lt;b&gt;Ops + run manifest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Reconcile node/model totals&lt;br&gt;Read scores and ladder reports&lt;br&gt;Track run state and failures&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#EAF3F8;strokeColor=#769BB4;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=18;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="535" width="300" height="170" /></mxCell><mxCell id="phoenix" value="&lt;b&gt;Phoenix / local spans&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;OTLP trace tree&lt;br&gt;Node, model and tool spans&lt;br&gt;Fallback: spans.jsonl&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F2F5F8;strokeColor=#9AA9B6;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=18;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="535" width="300" height="170" /></mxCell><mxCell id="comparisons" value="&lt;b&gt;Controlled agent comparisons&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;EX / SO / RK ladders; frozen seeds for solution and risk&lt;br&gt;Five repeats, intervals and keep/drop decisions; costs beside quality&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#F0ECF9;strokeColor=#A18BC7;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=18;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="800" width="720" height="120" /></mxCell><mxCell id="acceptance" value="&lt;b&gt;Release evidence | targets, not measured results&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Five live hero repeats: QS-2 median ≤2/45 misses; QS-3 no trap action&lt;br&gt;QS-5 no seeded gap claimed; QS-8 median Jaccard ≥0.85; ten owner labels&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;rounded=1;arcSize=8;fillColor=#FFF0D5;strokeColor=#D2A052;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=18;fontColor=#173047;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="800" width="720" height="120" /></mxCell><mxCell id="title" value="Bidwright | evidence that the system works" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#173047;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="38" width="1100" height="45" /></mxCell><mxCell id="subtitle" value="Quality and operational telemetry are separate streams, joined by the same run identity" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="93" width="1475" height="28" /></mxCell><mxCell id="footer" value="BIDWRIGHT / Submission diagrams / Accepted Iteration 3 design / Verify against the final build" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="962" width="1480" height="22" /></mxCell><mxCell id="eval-label" value="QUALITY / SEPARATE EVALUATION HARNESS" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="82" y="345" width="676" height="26" /></mxCell><mxCell id="obs-label" value="OPERATIONS / TELEMETRY" style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="842" y="345" width="676" height="26" /></mxCell><mxCell id="replay-note" value="Replay time is not live provider latency. Shadow cost is not a charge. Report remaining misses and accepted exceptions explicitly." style="html=1;whiteSpace=wrap;fontFamily=Arial;shadow=0;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#566A7D;fontSize=15;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="933" width="1480" height="22" /></mxCell></root></mxGraphModel></diagram></mxfile>