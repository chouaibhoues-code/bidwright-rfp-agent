}], "content_layer": "body", "meta": null, "label": "title", "prov": [], "orig": "Request for Proposal: Donor and Volunteer Management System", "text": "Request for Proposal: Donor and Volunteer Management System", "formatting": null, "hyperlink": null}, {"self_ref": "#/texts/1", "parent": {"$ref": "#/texts/0"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Fennick Lantern Trust", "text": "The Fennick Lantern Trust", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/2", "parent": {"$ref": "#/texts/0"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Reference FLT-2026-07. Issued 2026-12-01.", "text": "Reference FLT-2026-07. Issued 2026-12-01.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/3", "parent": {"$ref": "#/texts/0"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "This is a fictional document written to test software. The Fennick Lantern Trust is not a real organization.", "text": "This is a fictional document written to test software. The Fennick Lantern Trust is not a real organization.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/4", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/5"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "1 Introduction", "text": "1 Introduction", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/5", "parent": {"$ref": "#/texts/4"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Fennick Lantern Trust (the Trust) is a charity that runs reading clubs for children in four towns. It invites proposals for a cloud system to manage its donors, volunteers and events. The Trust has nine staff and about 600 volunteers, and it receives about 4,000 donations a year.", "text": "The Fennick Lantern Trust (the Trust) is a charity that runs reading clubs for children in four towns. It invites proposals for a cloud system to manage its donors, volunteers and events. The Trust has nine staff and about 600 volunteers, and it receives about 4,000 donations a year.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/6", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/7"}, {"$ref": "#/texts/8"}, {"$ref": "#/texts/9"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "2 Background", "text": "2 Background", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/7", "parent": {"$ref": "#/texts/6"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Trust's donor records are kept in a spreadsheet that the finance officer updates each week.", "text": "The Trust's donor records are kept in a spreadsheet that the finance officer updates each week.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/8", "parent": {"$ref": "#/texts/6"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Trust plans to open two new reading clubs in September 2027.", "text": "The Trust plans to open two new reading clubs in September 2027.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/9", "parent": {"$ref": "#/texts/6"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Volunteers book their sessions by e-mail today, and the club leaders keep the rotas on paper. The Trust's board approved the purchase of a new system at its meeting in October 2026.", "text": "Volunteers book their sessions by e-mail today, and the club leaders keep the rotas on paper. The Trust's board approved the purchase of a new system at its meeting in October 2026.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/10", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/11"}, {"$ref": "#/texts/12"}, {"$ref": "#/texts/13"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "3 Instructions", "text": "3 Instructions", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/11", "parent": {"$ref": "#/texts/10"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Proposals must be sent by e-mail to the Trust's office by 17:00 GMT on 2027-02-12, as one document of no more than 15 pages.", "text": "Proposals must be sent by e-mail to the Trust's office by 17:00 GMT on 2027-02-12, as one document of no more than 15 pages.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/12", "parent": {"$ref": "#/texts/10"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Trust answers questions about this request until 2027-01-29, and it shares every answer with all bidders. The Trust's office manager is the contact for this request.", "text": "The Trust answers questions about this request until 2027-01-29, and it shares every answer with all bidders. The Trust's office manager is the contact for this request.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/13", "parent": {"$ref": "#/texts/10"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "", "text": "", "formatting": null, "hyperlink": null}, {"self_ref": "#/texts/14", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/15"}, {"$ref": "#/texts/16"}, {"$ref": "#/texts/17"}, {"$ref": "#/groups/0"}, {"$ref": "#/texts/20"}, {"$ref": "#/texts/21"}, {"$ref": "#/texts/22"}, {"$ref": "#/texts/23"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "4 Requirements", "text": "4 Requirements", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/15", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system shall hold a record for each donor with their contact details and the history of their gifts.", "text": "The system shall hold a record for each donor with their contact details and the history of their gifts.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/16", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system shall record each donor's consent to be contacted by e-mail, by post and by telephone, with the date the consent was given.", "text": "The system shall record each donor's consent to be contacted by e-mail, by post and by telephone, with the date the consent was given.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/17", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "For volunteers, the system shall:", "text": "For volunteers, the system shall:", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/18", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [], "orig": "(a) record the hours each volunteer gives to each club;", "text": "(a) record the hours each volunteer gives to each club;", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null, "enumerated": true, "marker": "1."}, {"self_ref": "#/texts/19", "parent": {"$ref": "#/groups/0"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [], "orig": "(b) send each volunteer a reminder two days before every session they are booked on.", "text": "(b) send each volunteer a reminder two days before every session they are booked on.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null, "enumerated": true, "marker": "2."}, {"self_ref": "#/texts/20", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system should import the Trust's existing donor spreadsheet without manual retyping.", "text": "The system should import the Trust's existing donor spreadsheet without manual retyping.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/21", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system must keep all personal data in the United Kingdom.", "text": "The system must keep all personal data in the United Kingdom.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/22", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Bidders may offer a mobile app for volunteers as an optional extra.", "text": "Bidders may offer a mobile app for volunteers as an optional extra.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/23", "parent": {"$ref": "#/texts/14"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system shall be available 99% of the time in each calendar month.", "text": "The system shall be available 99% of the time in each calendar month.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/24", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/25"}, {"$ref": "#/texts/26"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "5 Timeline", "text": "5 Timeline", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/25", "parent": {"$ref": "#/texts/24"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The supplier shall train the Trust's staff before the system goes live.", "text": "The supplier shall train the Trust's staff before the system goes live.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/26", "parent": {"$ref": "#/texts/24"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The system must be live by 2027-06-30.", "text": "The system must be live by 2027-06-30.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/27", "parent": {"$ref": "#/texts/0"}, "children": [{"$ref": "#/texts/28"}, {"$ref": "#/tables/0"}], "content_layer": "body", "meta": null, "label": "section_header", "prov": [], "orig": "6 Evaluation", "text": "6 Evaluation", "formatting": null, "hyperlink": null, "level": 1}, {"self_ref": "#/texts/28", "parent": {"$ref": "#/texts/27"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "The Trust scores proposals on the criteria below.", "text": "The Trust scores proposals on the criteria below.", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/29", "parent": {"$ref": "#/groups/1"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Criterion", "text": "Criterion", "formatting": {"bold": true, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/30", "parent": {"$ref": "#/groups/2"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [], "orig": "Weight", "text": "Weight", "formatting": {"bold": true, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}, {"self_ref": "#/texts/31", "parent": {"$ref": "#/groups/3"}, "children": [], "content_layer": "furniture", "meta": null, "label": "text", "prov": [], "orig": "The Fennick Lantern Trust | RFP FLT-2026-07", "text": "The Fennick Lantern Trust | RFP FLT-2026-07", "formatting": {"bold": false, "italic": false, "underline": false, "strikethrough": false, "script": "baseline"}, "hyperlink": null}], "pictures": [], "tables": [{"self_ref": "#/tables/0", "parent": {"$ref": "#/texts/27"}, "children": [{"$ref": "#/groups/1"}, {"$ref": "#/groups/2"}], "content_layer": "body", "meta": null, "label": "table", "prov": [],