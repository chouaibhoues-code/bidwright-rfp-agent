# Copy this file to .env and put your keys there. Never put keys in this file.

# Required for the free profile, from Iteration 0a.
GEMINI_API_KEY=

# Optional: paid Gemini on the same models. Used by --profile paid only, within the paid budget
# (D-01: $40 for Iterations 2 and 3) and each matrix file's max_cost_usd.
GEMINI_PAID_API_KEY=

# Needed by Iteration 3, for assess, critic and judges.
CEREBRAS_API_KEY=

# Optional: failover for small assess calls.
GROQ_API_KEY=

# Optional: Context7 for live techcheck runs from Iteration 3, sent as an Authorization: Bearer header.
CONTEXT7_API_KEY=

# Optional: tracing. Compose sets http://phoenix:6006. Leave empty on the host to write spans.jsonl instead.
PHOENIX_ENDPOINT=

# Optional: Phoenix authentication, off for the local Compose collector. Set true to turn it on,
# then create a system key in Phoenix and put it in PHOENIX_API_KEY, sent as a bearer token.
PHOENIX_ENABLE_AUTH=
PHOENIX_API_KEY=

# Optional (ADR-053): the Phoenix project the spans go to, bidwright by default, and the address a
# browser opens Phoenix's pages at, when it differs from PHOENIX_ENDPOINT (Compose's phoenix:6006
# is not reachable from a browser, so links then use http://127.0.0.1:6006).
PHOENIX_PROJECT_NAME=
PHOENIX_UI_URL=

# Optional: the Ollama server. Defaults to http://localhost:11434 on the host; Compose sets
# http://ollama:11434. For Compose to use the host's own Ollama, pass its address per command
# rather than here: the host path reads this file too, and from the host itself that name does
# not reach an Ollama that listens on loopback only.
#   docker compose run --rm -e OLLAMA_HOST=http://host.docker.internal:11434 app run <file> --profile local
OLLAMA_HOST=

# Optional: the Docling parser service. Defaults to http://localhost:5001 on the host; Compose sets http://docling:5001.
DOCLING_URL=

# Optional: the NotebookLM MCP server for research mode live, on the host. Defaults to
# http://127.0.0.1:8000/mcp from config/research.yaml; Compose sets the container's address.
NOTEBOOKLM_MCP_URL=

# Optional: a folder outside the repository that holds client documents (D-05). A client
# document must sit under it, or the run ends POLICY_BLOCKED.
BIDWRIGHT_CLIENT_ROOT=
